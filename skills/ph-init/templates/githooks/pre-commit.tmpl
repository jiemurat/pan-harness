#!/bin/sh
# pre-commit (pan-harness): the harness checks run before every commit, the
# agent's and the owner's: a check holds where a text rule can be skipped. In the project this
# file is the executable .githooks/pre-commit, switched on with:
#   git config core.hooksPath .githooks
# (a project in a subfolder of a repository: the path from the repository's top,
# for example apps/book/.githooks). Errors stop the commit: fix the cause. Skipping
# the checks (git commit --no-verify) is the owner's decision, never the agent's.
# The checks run in the project: the folder above .githooks.
cd "$(dirname "$0")/.." || exit 1

if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: node not found - the checks did not run; run them by hand (pan-harness/playbooks/end-of-task.md -> End of task)" >&2
    exit 0
fi

out=$(node pan-harness/scripts/pan-harness-check.mjs 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$out" | grep -E '^ERROR' >&2
    echo "pre-commit: pan-harness-check found errors - fix them (pan-harness/playbooks/end-of-task.md -> End of task) and commit again" >&2
    exit 1
fi

# a harness below this one in the same repository runs its own check when the commit has
# its files: the repository has one hooksPath, so its own hook does not run
staged=$(git diff --cached --name-only --relative)
tab=$(printf '\t')
node pan-harness/scripts/pan-harness-check.mjs --harnesses | while IFS="$tab" read -r dir ver kind; do
    [ "$kind" = "same repo" ] || continue
    printf '%s\n' "$staged" | awk -v d="$dir/" 'index($0, d) == 1 { f = 1 } END { exit !f }' || continue
    [ -f "$dir/pan-harness/scripts/pan-harness-check.mjs" ] || continue
    out=$(node "$dir/pan-harness/scripts/pan-harness-check.mjs" 2>&1)
    if [ $? -ne 0 ]; then
        printf '%s\n' "$out" | grep -E '^ERROR' >&2
        echo "pre-commit: $dir: pan-harness-check found errors - fix them by the end-of-task playbook of that harness and commit again" >&2
        exit 1
    fi
    echo "pre-commit: $dir: pan-harness checks passed" >&2
done || exit 1

# secret-check.mjs is there when the profile lists sensitive-data=secrets; the
# project's staged files are scanned on top of its default paths
if [ -f pan-harness/scripts/secret-check.mjs ]; then
    out=$(git diff --cached --name-only --relative -z --diff-filter=ACMR | xargs -0 node pan-harness/scripts/secret-check.mjs 2>&1)
    if [ $? -ne 0 ]; then
        printf '%s\n' "$out" | grep -vE '^ *$' | tail -n 8 >&2
        echo "pre-commit: secret-check is not clean - remove the secret, then commit again" >&2
        exit 1
    fi
fi
echo "pre-commit: pan-harness checks passed" >&2
