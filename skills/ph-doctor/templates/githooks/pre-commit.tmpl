#!/bin/sh
# pre-commit (pan-harness): the harness checks run before every commit, the
# agent's and the owner's (AGENTS.md R5, principles P23). In the project this
# file is .githooks/pre-commit (executable), switched on with:
#   git config core.hooksPath .githooks
# Errors stop the commit: fix the cause. Skipping the checks
# (git commit --no-verify) is the owner's decision, never the agent's.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: node not found - the checks did not run; run them by hand (PAN-HARNESS.md -> End of task)" >&2
    exit 0
fi

out=$(node pan-harness/scripts/pan-harness-check.mjs 2>&1)
if [ $? -ne 0 ]; then
    printf '%s\n' "$out" | grep -E '^ERROR' >&2
    echo "pre-commit: pan-harness-check found errors - fix them (PAN-HARNESS.md -> End of task) and commit again" >&2
    exit 1
fi

# secret-check.mjs is there when the profile lists sensitive-data=secrets; the
# staged files are scanned on top of its default paths
if [ -f pan-harness/scripts/secret-check.mjs ]; then
    out=$(git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 node pan-harness/scripts/secret-check.mjs 2>&1)
    if [ $? -ne 0 ]; then
        printf '%s\n' "$out" | grep -vE '^ *$' | tail -n 8 >&2
        echo "pre-commit: secret-check is not clean - remove the secret, then commit again" >&2
        exit 1
    fi
fi
echo "pre-commit: pan-harness checks passed" >&2
